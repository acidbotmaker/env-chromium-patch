# A coherent Windows 11 / NVIDIA desktop profile.
#
#   set -a; . ./env.example; set +a
#   out/Release/chrome --user-data-dir=/tmp/profile1
#
# The values below are internally consistent on purpose: the UA string, the
# client hints, navigator.platform and the GPU strings all describe the same
# machine. Mixing a Windows UA with a Linux platform is more identifying than
# not spoofing at all.

# --- identity ---------------------------------------------------------------
CHROME_ENV_UA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36'
CHROME_ENV_PLATFORM='Win32'

# CHROME_ENV_UA_PLATFORM is derived from CHROME_ENV_PLATFORM ("Win32" ->
# "Windows"), so it only needs setting for something outside that mapping.
# The platform version is the UA-CH encoding of the Windows release: 15.0.0 is
# Windows 11, 10.0.0 is Windows 10.
CHROME_ENV_UA_PLATFORM_VERSION='15.0.0'

CHROME_ENV_VENDOR='Google Inc.'
CHROME_ENV_HARDWARE_CONCURRENCY='16'

# --- GPU --------------------------------------------------------------------
CHROME_ENV_WEBGL_VENDOR='Google Inc. (NVIDIA)'
CHROME_ENV_WEBGL_RENDERER='ANGLE (NVIDIA, NVIDIA GeForce RTX 3060 (0x00002503) Direct3D11 vs_5_0 ps_5_0, D3D11)'

# These two are what GL_VERSION and GL_SHADING_LANGUAGE_VERSION wrap. They are
# readable without the WEBGL_debug_renderer_info extension, so leaving them at
# the real driver's values would undo the renderer override above.
CHROME_ENV_WEBGL_VERSION='OpenGL ES 2.0.0 (ANGLE 2.1.0.dcb693a35e0d)'
CHROME_ENV_WEBGL_SHADING_LANGUAGE_VERSION='OpenGL ES GLSL ES 1.00 (ANGLE 2.1.0.dcb693a35e0d)'

CHROME_ENV_WEBGPU_VENDOR='nvidia'
CHROME_ENV_WEBGPU_ARCHITECTURE='ampere'

# --- media devices ----------------------------------------------------------
# Labels only become visible once the page has camera/microphone permission,
# same as unpatched Chrome. deviceId values are HMAC'd per origin downstream,
# so JS sees hashes rather than these strings.
CHROME_ENV_MEDIA_DEVICES='{
  "audioinput": [
    {"deviceId": "default", "label": "Default - Microphone (Realtek(R) Audio)", "groupId": "grp-onboard"},
    {"deviceId": "mic-onboard", "label": "Microphone (Realtek(R) Audio)", "groupId": "grp-onboard"}
  ],
  "videoinput": [
    {"deviceId": "cam-usb-0", "label": "HD Pro Webcam C920 (046d:082d)", "groupId": "grp-usb-cam", "facingMode": "user"}
  ],
  "audiooutput": [
    {"deviceId": "default", "label": "Default - Speakers (Realtek(R) Audio)", "groupId": "grp-onboard"},
    {"deviceId": "spk-onboard", "label": "Speakers (Realtek(R) Audio)", "groupId": "grp-onboard"}
  ]
}'
